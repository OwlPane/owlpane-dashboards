          "markdownContent": "Browse CRDs and CR instances from **Infrastructure → Kubernetes → Custom resources**, or query `k8s_events` logs with `body_kind = 'CustomResourceDefinition'` in Logs SQL.",
          "queryType": "sql",
          "queries": [
            {
              "query": null,
              "fields": {
                "stream_type": "logs"
              }
            }
          ],
          "layout": {
            "x": 0,

          "title": "HPA desired replicas",
          "queryType": "promql",
          "queries": [
            {
              "query": "k8s.hpa.desired_replicas{k8s.cluster.name=~\"$k8s_cluster\"}",
              "customQuery": true,
              "fields": {
                "stream": "k8s.hpa.desired_replicas",
                "stream_type": "metrics"
              }
            }
          ],
          "layout": {
            "x": 0,
            "y": 0,
